# Production reverse proxy. DOMAIN comes from the environment (compose sets it
# from .env). Caddy issues and renews Let's Encrypt certs itself, which only
# works once the domain resolves to this box's elastic IP.
#
#   /health       -> Caddy itself (deploy + CI health checks)
#   /api/*        -> F# server (prefix kept; the server routes on /api/...)
#   /mcp          -> F# server: the MCP endpoint
#   /.well-known/oauth-protected-resource* -> F# server: RFC 9728 metadata
#   /powersync/*  -> PowerSync service (prefix stripped)
#   /*            -> static client, SPA fallback to index.html
#   auth.<domain> -> Keycloak

{$DOMAIN} {
    encode zstd gzip

    handle /health {
        respond "OK" 200
    }

    handle /api/* {
        reverse_proxy server:5050
    }

    handle /mcp* {
        reverse_proxy server:5050
    }

    handle /.well-known/oauth-protected-resource* {
        reverse_proxy server:5050
    }

    handle /powersync/* {
        uri strip_prefix /powersync
        reverse_proxy powersync:8080 {
            # The sync stream is a long-lived streaming response; never buffer it.
            flush_interval -1
        }
    }

    handle {
        root * /srv
        # Hashed bundles never change; everything else (index.html, the service
        # worker, manifest, brand files) is revalidated so deploys show up.
        @immutable path /assets/*
        header @immutable Cache-Control "public, max-age=31536000, immutable"
        @volatile not path /assets/*
        header @volatile Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}

www.{$DOMAIN} {
    redir https://{$DOMAIN}{uri} permanent
}

auth.{$DOMAIN} {
    encode zstd gzip
    # Keycloak builds its URLs from KC_HOSTNAME and reads the forwarded
    # scheme/host (KC_PROXY_HEADERS=xforwarded), which Caddy sets by default.
    reverse_proxy keycloak:8080
}
