# Local-only credentials. Loaded by docker compose (variable substitution)
# and by dev.sh (exported to the F# server).

PG_USER=postgres
PG_PASSWORD=postgres
PG_PORT=5432
# App database (replicated by PowerSync) and PowerSync's own bucket storage
# live on the same Postgres instance as two separate databases.
PG_APP_DB=pantry
PG_STORAGE_DB=powersync_storage

PS_PORT=8080
# Shared HS256 secret used to sign PowerSync JWTs. The server signs with the
# raw value; the PowerSync service verifies with the base64url form below.
POWERSYNC_JWT_SECRET=plaintextpantry-local-dev-jwt-secret-change-me-before-anyone-cares
POWERSYNC_JWT_SECRET_B64=cGxhaW50ZXh0cGFudHJ5LWxvY2FsLWRldi1qd3Qtc2VjcmV0LWNoYW5nZS1tZS1iZWZvcmUtYW55b25lLWNhcmVz

# Keycloak (local dev mode). The realm, client and a dev user are created by
# infra/keycloak/provision.sh on every ./dev.sh; prod uses the same script with
# values from SSM. Sign in locally as dev@localhost / dev.
KC_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=plaintextpantry
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_CLIENT_ID=plaintextpantry-web
KEYCLOAK_CLIENT_SECRET=plaintextpantry-local-dev-client-secret
KEYCLOAK_DEV_USER=true
# Where the browser reaches the app, and the MCP server's resource identifier.
APP_URL=http://localhost:5173
MCP_RESOURCE=http://localhost:5050/mcp
