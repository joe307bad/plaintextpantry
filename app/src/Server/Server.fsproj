<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <WarningsAsErrors>FS0025</WarningsAsErrors>
    <!-- Vite serves the client; also sidesteps a dotnet-watch path bug on macOS. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Config.fs" />
    <Compile Include="Jwt.fs" />
    <Compile Include="Auth.fs" />
    <Compile Include="Db.fs" />
    <Compile Include="Mcp.fs" />
    <Compile Include="Api.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Shared/Shared.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Giraffe" Version="8.*" />
    <PackageReference Include="Thoth.Json.System.Text.Json" Version="0.*" />
    <PackageReference Include="Npgsql" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.*" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.*" />
  </ItemGroup>
</Project>
